[{"i": 0, "t": "בספר כה עשו חכמינו מסופר", "s": 0, "e": 2.4, "g": 0}, {"i": 1, "t": "על גבאי צדקה באחת העיירות,", "s": 2.4, "e": 4.7, "g": 0}, {"i": 2, "t": "שהיה ידוע בלב הענק שלו", "s": 4.7, "e": 7.2, "g": 0}, {"i": 3, "t": "יום אחד,", "s": 7.9, "e": 8.7, "g": 0}, {"i": 4, "t": "ניגש אליו יהודי עני", "s": 8.83, "e": 10.6, "g": 0}, {"i": 5, "t": "הוא השפיל מבט,", "s": 11.1, "e": 12.45, "g": 0}, {"i": 6, "t": "התבייש נורא לבקש עזרה,", "s": 12.6, "e": 14.3, "g": 0}, {"i": 7, "t": "ולחש בקול רועד...", "s": 14.3, "e": 16.2, "g": 0}, {"i": 8, "t": "רבי...", "s": 16.5, "e": 17.5, "g": 1}, {"i": 9, "t": "אין לי במה לקנות אוכל", "s": 17.81, "e": 19.0, "g": 1}, {"i": 10, "t": "לילדים שלי היום", "s": 19.0, "e": 20.8, "g": 1}, {"i": 11, "t": "הלב של הגבאי נצבט", "s": 21.58, "e": 23.0, "g": 0}, {"i": 12, "t": "אבל הוא לא שלף מיד ארנק מול כולם,", "s": 23.0, "e": 25.3, "g": 0}, {"i": 13, "t": "כדי לא לבייש אותו", "s": 25.3, "e": 27.5, "g": 0}, {"i": 14, "t": "במקום זה, הוא הסתכל סביב,", "s": 27.95, "e": 30.5, "g": 0}, {"i": 15, "t": "חייך אליו בחום ואמר...", "s": 30.79, "e": 33.1, "g": 0}, {"i": 16, "t": "תגיד לי,", "s": 33.51, "e": 34.3, "g": 1}, {"i": 17, "t": "יש לך במקרה איזה חפץ ישן", "s": 34.43, "e": 36.3, "g": 1}, {"i": 18, "t": "בבית שאתה לא צריך?", "s": 36.3, "e": 38.55, "g": 1}, {"i": 19, "t": "אפילו כפית שבורה או ספר ישן?", "s": 38.69, "e": 42.0, "g": 1}, {"i": 20, "t": "העני התפלא", "s": 42.75, "e": 44.1, "g": 0}, {"i": 21, "t": "הוא הכניס יד לכיס,", "s": 44.43, "e": 46.0, "g": 0}, {"i": 22, "t": "הוציא מפתח חלוד שלא פתח שום דלת", "s": 46.0, "e": 49.2, "g": 0}, {"i": 23, "t": "ואמר במבוכה:", "s": 49.36, "e": 50.9, "g": 0}, {"i": 24, "t": "רק את זה יש לי...", "s": 51.13, "e": 53.3, "g": 1}, {"i": 25, "t": "הגבאי לקח את המפתח בעניין רב", "s": 53.7, "e": 56.0, "g": 0}, {"i": 26, "t": "כאילו מצא עכשיו אוצר קטן!", "s": 56.0, "e": 58.6, "g": 0}, {"i": 27, "t": "הוא הוציא סכום כסף מכובד,", "s": 58.92, "e": 60.9, "g": 0}, {"i": 28, "t": "לחץ לו את היד בחום ואמר בחיוך...", "s": 61.09, "e": 64.0, "g": 0}, {"i": 29, "t": "בדיוק מפתח כזה חיפשתי!", "s": 64.18, "e": 66.7, "g": 1}, {"i": 30, "t": "תודה רבה שמכרת לי אותו", "s": 66.87, "e": 69.0, "g": 1}, {"i": 31, "t": "העני יצא משם", "s": 69.92, "e": 71.3, "g": 0}, {"i": 32, "t": "עם ראש מורם וחיוך גדול", "s": 71.3, "e": 73.5, "g": 0}, {"i": 33, "t": "הוא לא יצא כמקבל צדקה...", "s": 73.77, "e": 76.1, "g": 0}, {"i": 34, "t": "הוא יצא כאדם מכובד שסגר עסקה", "s": 76.3, "e": 79.7, "g": 0}, {"i": 35, "t": "אתם מבינים?", "s": 80.39, "e": 81.7, "g": 0}, {"i": 36, "t": "לפעמים, הדרך שבה אנחנו נותנים", "s": 81.96, "e": 84.5, "g": 0}, {"i": 37, "t": "חשובה אפילו יותר ממה שאנחנו נותנים", "s": 84.5, "e": 87.8, "g": 0}, {"i": 38, "t": "כשהכבוד של האדם שמולנו נשאר שלם...", "s": 88.38, "e": 91.6, "g": 0}, {"i": 39, "t": "הנתינה הופכת לקסם אמיתי", "s": 91.94, "e": 94.6, "g": 1}, {"i": 40, "t": "שיהיה לנו יום מלא בעין טובה", "s": 95.18, "e": 97.79, "g": 0}]